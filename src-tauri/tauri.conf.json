      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREQkZBNUQxMjNEQjM1NUQKUldSZE5kc2owYVcvM1FJZkVNeHVjVmI4YXp6dkhPaGVyM3g3UkhFZ1JWcjhzSDNqc0dKVlpkSFgK",
      "endpoints": ["https://mytalk.pjimenezpf.com/downloads/update.json"]
