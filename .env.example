# =============================================================================
# MyTalk — variables de entorno / environment variables
# Copia a .env y rellena los valores. Nunca subas .env al repositorio.
# Copy to .env and fill in values. Never commit .env to the repository.
# =============================================================================

# --- Aplicación / Application ---
APP_NAME=MyTalk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos / Database ---
# SQLite por defecto en desarrollo. MySQL recomendado en producción.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=mytalk
# DB_USERNAME=mytalk
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Tiempo real (Laravel Reverb) / Realtime (Laravel Reverb) ---
# Obligatorio para chat, hilos, voz (señalización) y presencia.
# Required for chat, threads, voice (signaling), and presence.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=mytalk-local
REVERB_APP_KEY=genera-una-clave-segura
REVERB_APP_SECRET=genera-un-secreto-seguro
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Servidor Reverb (php artisan reverb:start)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Expuestas al frontend (Vite). Deben coincidir con REVERB_* de arriba.
# Exposed to the frontend (Vite). Must match the REVERB_* values above.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Web Push (VAPID) — opcional / optional ---
# Notificaciones push en el navegador. Sin claves, el resto de la app funciona.
# Browser push notifications. Without keys, the rest of the app still works.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- OAuth social (opcional) / Social OAuth (optional) ---
# Solo si registras apps en cada proveedor. Rutas: /auth/{provider}/redirect
# Only if you register apps with each provider. Routes: /auth/{provider}/redirect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/auth/linkedin/callback"

# --- Correo / Mail (opcional) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Redis (opcional; escalado Reverb) / Redis (optional; Reverb scaling) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
